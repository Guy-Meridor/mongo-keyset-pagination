{
  "name": "mongo-keyset-pagination",
  "version": "0.1.0",
  "description": "Generic keyset (cursor) pagination for MongoDB aggregation pipelines.",
  "author": "Guy Meridor",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "keywords": ["mongodb", "pagination", "keyset", "cursor", "aggregation", "seek"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guy-Meridor/mongo-keyset-pagination.git"
  },
  "bugs": {
    "url": "https://github.com/Guy-Meridor/mongo-keyset-pagination/issues"
  },
  "homepage": "https://github.com/Guy-Meridor/mongo-keyset-pagination#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "mongodb": ">=5",
    "bson": ">=5"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^10.13.0",
    "@types/node": "^20.14.0",
    "bson": "^6.8.0",
    "mongodb": "^6.8.0",
    "testcontainers": "^10.13.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
